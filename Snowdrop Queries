1. Overview of dataset

SELECT
  COUNT(*) AS number_of_rows,
  MIN(date) AS first_date,
  MAX(date) AS last_date,
  COUNT(DISTINCT date) AS number_of_dates
FROM `airy-web-509601-b3.ecommerce.ecommerce data`;
---------
2. Mobile vs Desktop

SELECT
  device,
  SUM(view_item) AS product_views,
  SUM(add_to_cart) AS add_to_carts,
  ROUND(
    SAFE_DIVIDE(SUM(add_to_cart), SUM(view_item)) * 100,
    2
  ) AS view_to_cart_percent
FROM `airy-web-509601-b3.ecommerce.ecommerce data`
GROUP BY device
ORDER BY view_to_cart_percent;
